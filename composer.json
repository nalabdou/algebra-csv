{
    "name": "nalabdou/algebra-csv",
    "description": "CSV adapter for algebra-php — file paths, SplFileInfo, raw strings, resource handles. Auto-detect delimiter, encoding conversion, type coercion.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Nadim Al Abdou",
            "email": "nadim.alabdou@gmail.com",
            "homepage": "https://github.com/nalabdou",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nalabdou/algebra-php": "^1.0",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.60"
    },
    "autoload": {
        "psr-4": {
            "Nalabdou\\Algebra\\Csv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nalabdou\\Algebra\\Csv\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "nalabdou/algebra-symfony": "Symfony bundle — register CsvFileAdapter via #[AsAlgebraAdapter(priority: 50)]"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
